{
  "name": "vscode-tmux-terminals",
  "displayName": "Tmux Terminals",
  "description": "一键恢复 Remote-SSH 断开后的终端工作区",
  "version": "0.2.1",
  "publisher": "KryieNaruto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KryieNaruto/vscode-tmux-terminals.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onView:tmuxTerminals.list"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tmuxTerminals",
          "title": "我的终端",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "tmuxTerminals": [
        {
          "id": "tmuxTerminals.list",
          "name": "终端清单"
        },
        {
          "id": "tmuxTerminals.batch",
          "name": "批量操作"
        }
      ]
    },
    "commands": [
      {
        "command": "tmuxTerminals.open",
        "title": "打开终端",
        "icon": "$(terminal)"
      },
      {
        "command": "tmuxTerminals.add",
        "title": "新建终端条目",
        "icon": "$(add)"
      },
      {
        "command": "tmuxTerminals.edit",
        "title": "编辑",
        "icon": "$(edit)"
      },
      {
        "command": "tmuxTerminals.duplicate",
        "title": "复制",
        "icon": "$(copy)"
      },
      {
        "command": "tmuxTerminals.delete",
        "title": "删除条目",
        "icon": "$(trash)"
      },
      {
        "command": "tmuxTerminals.addInFolder",
        "title": "在此目录新建终端",
        "icon": "$(add)"
      },
      {
        "command": "tmuxTerminals.addSession",
        "title": "新建会话",
        "icon": "$(add)"
      },
      {
        "command": "tmuxTerminals.closeSession",
        "title": "关闭会话",
        "icon": "$(close)"
      },
      {
        "command": "tmuxTerminals.deleteSession",
        "title": "删除会话",
        "icon": "$(trash)"
      },
      {
        "command": "tmuxTerminals.setColor",
        "title": "设置颜色…",
        "icon": "$(symbol-color)"
      },
      {
        "command": "tmuxTerminals.killSession",
        "title": "关闭该终端下全部会话",
        "icon": "$(stop-circle)"
      },
      {
        "command": "tmuxTerminals.toggleAutoRestore",
        "title": "切换「参与全部恢复」",
        "icon": "$(check)"
      },
      {
        "command": "tmuxTerminals.restoreAll",
        "title": "全部恢复",
        "icon": "$(history)"
      },
      {
        "command": "tmuxTerminals.refresh",
        "title": "刷新状态",
        "icon": "$(refresh)"
      },
      {
        "command": "tmuxTerminals.bindConversation",
        "title": "选择要接回的对话…",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "tmuxTerminals.setModel",
        "title": "设置模型…",
        "icon": "$(chip)"
      },
      {
        "command": "tmuxTerminals.setProfile",
        "title": "切换直连/中转",
        "icon": "$(plug)"
      },
      {
        "command": "tmuxTerminals.batchSetCcr",
        "title": "设为中转",
        "icon": "$(cloud)"
      },
      {
        "command": "tmuxTerminals.batchSetDirect",
        "title": "设为直连",
        "icon": "$(plug)"
      },
      {
        "command": "tmuxTerminals.batchSetModel",
        "title": "批量设置模型…",
        "icon": "$(chip)"
      },
      {
        "command": "tmuxTerminals.batchClear",
        "title": "清空选择",
        "icon": "$(clear-all)"
      },
      {
        "command": "tmuxTerminals.batchToggle",
        "title": "切换选中（内部）"
      },
      {
        "command": "tmuxTerminals.batchToggleFolder",
        "title": "切换文件夹选中（内部）"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tmuxTerminals.restoreAll",
          "when": "view == tmuxTerminals.list",
          "group": "navigation@1"
        },
        {
          "command": "tmuxTerminals.add",
          "when": "view == tmuxTerminals.list",
          "group": "navigation@2"
        },
        {
          "command": "tmuxTerminals.refresh",
          "when": "view == tmuxTerminals.list",
          "group": "navigation@3"
        },
        {
          "command": "tmuxTerminals.batchSetCcr",
          "when": "view == tmuxTerminals.batch",
          "group": "navigation@1"
        },
        {
          "command": "tmuxTerminals.batchSetDirect",
          "when": "view == tmuxTerminals.batch",
          "group": "navigation@2"
        },
        {
          "command": "tmuxTerminals.batchSetModel",
          "when": "view == tmuxTerminals.batch",
          "group": "navigation@3"
        },
        {
          "command": "tmuxTerminals.batchClear",
          "when": "view == tmuxTerminals.batch",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "tmuxTerminals.open",
          "when": "view == tmuxTerminals.list && (viewItem == sessionAlive || viewItem == sessionDead)",
          "group": "inline@1"
        },
        {
          "command": "tmuxTerminals.closeSession",
          "when": "view == tmuxTerminals.list && viewItem == sessionAlive",
          "group": "inline@2"
        },
        {
          "command": "tmuxTerminals.addInFolder",
          "when": "view == tmuxTerminals.list && viewItem == folder",
          "group": "inline@1"
        },
        {
          "command": "tmuxTerminals.addSession",
          "when": "view == tmuxTerminals.list && viewItem == terminal",
          "group": "inline@1"
        },
        {
          "command": "tmuxTerminals.edit",
          "when": "view == tmuxTerminals.list && viewItem == terminal",
          "group": "2_edit@0"
        },
        {
          "command": "tmuxTerminals.setColor",
          "when": "view == tmuxTerminals.list && (viewItem == terminal || viewItem == sessionAlive || viewItem == sessionDead)",
          "group": "2_edit@1"
        },
        {
          "command": "tmuxTerminals.setModel",
          "when": "view == tmuxTerminals.list && (viewItem == terminal || viewItem == sessionAlive || viewItem == sessionDead)",
          "group": "2_edit@2"
        },
        {
          "command": "tmuxTerminals.setProfile",
          "when": "view == tmuxTerminals.list && (viewItem == terminal || viewItem == sessionAlive || viewItem == sessionDead)",
          "group": "2_edit@3"
        },
        {
          "command": "tmuxTerminals.bindConversation",
          "when": "view == tmuxTerminals.list && (viewItem == sessionAlive || viewItem == sessionDead)",
          "group": "2_edit@4"
        },
        {
          "command": "tmuxTerminals.duplicate",
          "when": "view == tmuxTerminals.list && (viewItem == terminal || viewItem == sessionAlive || viewItem == sessionDead)",
          "group": "2_edit@5"
        },
        {
          "command": "tmuxTerminals.toggleAutoRestore",
          "when": "view == tmuxTerminals.list && (viewItem == terminal || viewItem == sessionAlive || viewItem == sessionDead)",
          "group": "2_edit@6"
        },
        {
          "command": "tmuxTerminals.killSession",
          "when": "view == tmuxTerminals.list && viewItem == terminal",
          "group": "1_close@1"
        },
        {
          "command": "tmuxTerminals.deleteSession",
          "when": "view == tmuxTerminals.list && (viewItem == sessionAlive || viewItem == sessionDead)",
          "group": "3_danger@1"
        },
        {
          "command": "tmuxTerminals.delete",
          "when": "view == tmuxTerminals.list && viewItem == terminal",
          "group": "3_danger@2"
        }
      ],
      "commandPalette": [
        {
          "command": "tmuxTerminals.batchToggle",
          "when": "false"
        },
        {
          "command": "tmuxTerminals.batchToggleFolder",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Tmux Terminals",
      "properties": {
        "tmuxTerminals.pollInterval": {
          "type": "number",
          "default": 10000,
          "markdownDescription": "存活状态轮询间隔（毫秒）。设为 `0` 关闭轮询。"
        },
        "tmuxTerminals.tmuxPath": {
          "type": "string",
          "default": "tmux",
          "markdownDescription": "tmux 可执行文件路径。不在 PATH 里时填绝对路径。"
        },
        "tmuxTerminals.storagePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "条目清单文件路径。留空则使用扩展的远端存储目录。重装扩展会清空该目录，需要长期保留时请指定一个固定路径。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && mocha \"out/test/**/*.test.js\"",
    "e2e": "npm run compile && node test/e2e-harness.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "mocha": "^10.3.0",
    "typescript": "^5.3.3"
  }
}
